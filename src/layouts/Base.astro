---
/**
 * Documento comum aos 4 layouts de teste. Cada layout escolhe as próprias fontes
 * e a cor do navegador; o conteúdo e o CSS vêm do slot.
 */
import { Font } from 'astro:assets';
import DadosCardapio from '../components/DadosCardapio.astro';
import { loja } from '../data/loja';
import { withBase } from '../lib/with-base';

type Fonte = '--font-ombros' | '--font-ultra' | '--font-schibsted' | '--font-fragment' | '--font-bagel';

interface Props {
  titulo: string;
  descricao?: string;
  /** Fontes do layout; `preload` só na que aparece na primeira tela. */
  fontes: { variavel: Fonte; preload?: boolean }[];
  corTema: string;
  esquema?: 'dark' | 'light';
  noindex?: boolean;
}

const {
  titulo,
  descricao = `${loja.slogan}. Hambúrguer artesanal com entrega em ${loja.bairroBase} e bairros vizinhos, ${loja.horario.texto.toLowerCase()}. Peça pelo WhatsApp.`,
  fontes,
  corTema,
  esquema = 'dark',
  noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-sacola="vazia" data-loja="fechada" style={`color-scheme: ${esquema}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Same policy as public/_headers, for hosts that ignore it (GitHub Pages). -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
    />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {fontes.map((f) => <Font cssVariable={f.variavel} preload={f.preload} />)}
    <meta name="theme-color" content={corTema} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <DadosCardapio />
    <script src="../scripts/sacola-ui.ts"></script>
  </body>
</html>
