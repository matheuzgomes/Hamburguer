---
/**
 * Layout de teste 3 — Comanda.
 * Cena: 18h50 no trem, uma mão no celular, decidindo em 30 segundos. Claro e contido:
 * branco neutro, tinta preta e mostarda só como marca-texto e carimbo. Busca e abas no
 * topo, lista densa com miniaturas e a sacola como cupom de impressora térmica.
 */
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Icone from '../../components/Icone.astro';
import Bairros from '../../components/comum/Bairros.astro';
import Barra from '../../components/comum/Barra.astro';
import Fatos from '../../components/comum/Fatos.astro';
import Perguntas from '../../components/comum/Perguntas.astro';
import Sacola from '../../components/comum/Sacola.astro';
import Item from '../../components/l3/Item.astro';
import { doGrupo, grupos, nomesEtiquetas, type Etiqueta, type Grupo } from '../../data/cardapio';
import { loja } from '../../data/loja';
import { provas } from '../../data/textos';
import { preco } from '../../lib/dinheiro';
import { urlWhatsApp } from '../../lib/whatsapp';
import icone from '../../assets/marca/icone.svg?url';
import logoTraco from '../../assets/marca/logo-traco.svg?url';
import { caminho } from '../../lib/caminho';

const subtitulos: Record<Grupo, string> = {
  'so-eu': 'Todo combo vem com batata frita e Coca-Cola lata.',
  'a-dois': 'Dois lanches e refri grande pra dividir.',
  familia: 'Três ou quatro lanches, batatas e Coca-Cola 1,5 L.',
  extras: 'Pra completar o pedido ou beliscar sozinho.',
};
const filtros: Etiqueta[] = ['smash', 'artesanal', 'bacon', 'cheddar', 'frango', 'salada', 'catupiry'];
const secoes = grupos.map((g) => ({ ...g, itens: doGrupo(g.id) }));
const total = secoes.reduce((n, s) => n + s.itens.length, 0);
const whatsappSimples = urlWhatsApp(loja.whatsapp, 'Oi, Nossa! Quero fazer um pedido.');
---

<Base
  titulo="Nossa Hamburgueria · Comanda (teste 3)"
  fontes={[{ variavel: '--font-schibsted', preload: true }, { variavel: '--font-fragment' }]}
  corTema="#fbfbfb"
  esquema="light"
>
  <header class="topo">
    <a class="marca-topo" href="#cardapio">
      <img src={icone} alt="" width="34" height="29" />
      <span>Nossa Hamburgueria</span>
    </a>
    <p class="status"><span class="ponto" aria-hidden="true"></span><span data-status-loja>{loja.horario.texto}</span></p>
  </header>

  <section class="abertura" aria-labelledby="t-abertura">
    <h1 id="t-abertura">Da nossa chapa direto pra sua casa</h1>
    <p class="sub">Hambúrguer artesanal com blend moído na casa. Escolhe aqui, a gente recebe no WhatsApp.</p>
    <ul class="fatos-linha">
      <li><Icone nome="moto" tamanho={18} /> {loja.entrega.gratisNosBairros ? 'Entrega grátis' : 'Entrega'} em {loja.bairroBase} e vizinhança</li>
      <li><Icone nome="relogio" tamanho={18} /> {loja.entrega.tempo}</li>
      <li>Mínimo {preco(loja.entrega.pedidoMinimo)}</li>
    </ul>
    <div class="filtros" role="group" aria-label="Filtrar por ingrediente">
      {
        filtros.map((e) => (
          <button type="button" class="filtro" data-filtro-etiqueta={e} data-filtro-nome={nomesEtiquetas[e]} aria-pressed="false">
            {nomesEtiquetas[e]}
          </button>
        ))
      }
    </div>
  </section>

  <div class="barra-busca">
    <div class="busca">
      <Icone nome="busca" tamanho={20} />
      <input
        type="search"
        data-filtro-busca
        aria-label="Buscar no cardápio"
        placeholder="Buscar: bacon, frango, duplo…"
        enterkeyhint="search"
        autocomplete="off"
      />
    </div>
    <nav class="abas" aria-label="Cardápio por quantidade de pessoas">
      {secoes.map((s) => <a href={`#${s.id}`} data-aba={s.id}>{s.pergunta}</a>)}
    </nav>
    <p class="contagem">
      <span data-filtro-contagem aria-live="polite">{total} itens</span>
      <button type="button" class="limpar" data-filtro-limpar hidden>Limpar filtro</button>
    </p>
  </div>

  <div class="corpo">
    <main id="cardapio">
      <h2 class="sr-only">Cardápio</h2>
      {
        secoes.map((s) => (
          <section class="grupo" id={s.id} data-filtro-grupo aria-labelledby={`t-${s.id}`}>
            <div class="grupo-topo">
              <h2 id={`t-${s.id}`}>{s.pergunta}</h2>
              <p>{subtitulos[s.id]}</p>
            </div>
            <ul class="lista">
              {s.itens.map((item) => (
                <Item item={item} />
              ))}
            </ul>
          </section>
        ))
      }
      <div class="vazio" data-filtro-vazio hidden>
        <p class="vazio-titulo">Nada com “<span data-filtro-termo></span>” no cardápio.</p>
        <p>Tenta “bacon”, “frango” ou “duplo”.</p>
        <button type="button" class="botao botao-linha" data-filtro-limpar>Limpar busca</button>
      </div>
    </main>

    <aside class="cupom-lateral" aria-labelledby="t-cupom">
      <div class="cupom">
        <div class="cupom-cabeca" aria-hidden="true">
          <p>NOSSA HAMBURGUERIA</p>
          <p>ARTESANAL · {loja.bairroBase.toUpperCase()}</p>
          <p>PEDIDO PELO WHATSAPP</p>
        </div>
        <h2 id="t-cupom" class="cupom-titulo">Seu pedido</h2>
        <p class="cupom-vazio">Nenhum item ainda. Escolhe um lanche e ele aparece aqui.</p>
        <ul class="cupom-lista" data-sacola-lista>
          <template data-modelo-linha>
            <li class="cupom-linha">
              <span class="cupom-qtd"><span data-linha="qtd"></span>x</span>
              <span class="cupom-nome" data-linha="nome"></span>
              <span class="cupom-valor" data-linha="subtotal"></span>
            </li>
          </template>
        </ul>
        <p class="cupom-total"><span>TOTAL</span><span data-sacola-total>{preco(0)}</span></p>
        <p class="cupom-falta" data-falta-minimo hidden>Faltam <span data-falta-valor></span> pro mínimo.</p>
        <button type="button" class="botao botao-cheio cupom-fechar" data-abrir="sacola" aria-haspopup="dialog">Conferir e enviar</button>
      </div>
    </aside>
  </div>

  <section class="prova" aria-labelledby="t-prova">
    <Foto nome="ig-moedor" alt="Carne saindo do moedor na cozinha da Nossa" larguras={[160, 306]} sizes="10rem" class="prova-foto" />
    <div>
      <h2 id="t-prova">A carne é moída aqui</h2>
      <p>{provas.blend} {provas.sal}</p>
      <p class="seguidores"><strong>{loja.seguidores}</strong> pessoas acompanham a chapa no Instagram.</p>
    </div>
  </section>

  <div class="info">
    <section id="entrega" aria-labelledby="t-entrega">
      <h2 id="t-entrega">Entrega no seu bairro?</h2>
      <Bairros />
      <Fatos />
    </section>
    <section aria-labelledby="t-perguntas">
      <h2 id="t-perguntas">Antes de pedir</h2>
      <Perguntas />
    </section>
  </div>

  <footer class="rodape">
    <img src={logoTraco} alt="Nossa Hamburgueria Artesanal" width="88" height="103" loading="lazy" />
    <ul>
      <li><a href={whatsappSimples} data-enviar target="_blank" rel="noopener"><Icone nome="whatsapp" tamanho={20} /> {loja.whatsappExibicao}</a></li>
      <li><a href={loja.instagramUrl} target="_blank" rel="noopener"><Icone nome="instagram" tamanho={20} /> @{loja.instagram}</a></li>
      <li><button type="button" data-compartilhar><Icone nome="compartilhar" tamanho={20} /> Manda pra quem vai dividir</button></li>
    </ul>
    <p class="fino">{loja.slogan}. {loja.horario.texto}. Layout de teste 3 de 4 · <a href={caminho()}>ver os outros</a></p>
  </footer>

  <Barra rotulo="Ver pedido" />
  <Sacola titulo="Seu pedido" rotuloTotal="TOTAL" classe="cupom-dialogo">
    <div slot="topo" class="cupom-cabeca" aria-hidden="true">
      <p>NOSSA HAMBURGUERIA ARTESANAL</p>
      <p>{loja.bairroBase.toUpperCase()} · {loja.whatsappExibicao}</p>
    </div>
    <p slot="pe" class="carimbo" aria-hidden="true">Pedido pronto</p>
  </Sacola>

  <script src="../../scripts/trilhas.ts"></script>
  <script src="../../scripts/filtro.ts"></script>
  <script src="../../scripts/carimbo.ts"></script>
</Base>

<style is:global>
  :root {
    --papel: oklch(0.985 0 0);
    --cinza: oklch(0.955 0 0);
    --linha: oklch(0.88 0 0);
    --tinta: oklch(0.2 0.01 60);
    --tinta-2: oklch(0.43 0.006 60);
    --mostarda: oklch(0.82 0.15 80);
    --termico: oklch(0.965 0.003 90);
    --display: var(--font-schibsted);
    --mono: var(--font-fragment);
    --margem: max(1rem, calc((100vw - 76rem) / 2));
    --sai: cubic-bezier(0.22, 1, 0.36, 1);
    --z-busca: 10;
    --z-barra: 20;
    --z-aviso: 30;
    scroll-padding-top: 8.5rem;
    scroll-behavior: smooth;
  }

  html:has(dialog[open]) {
    overflow: hidden;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
  }

  body {
    background: var(--papel);
    color: var(--tinta);
    font: 400 1rem/1.5 var(--display);
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  button {
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
  }

  a {
    color: inherit;
  }

  [hidden] {
    display: none !important;
  }

  :focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  h1,
  h2,
  h3 {
    line-height: 1.1;
    text-wrap: balance;
  }

  /* ---------- Botões ---------- */
  .botao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    font-weight: 800;
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s,
      scale 0.15s var(--sai);
  }

  .botao:active {
    scale: 0.97;
  }

  .botao svg,
  .botao-add svg,
  .barra-botao svg,
  .botao-texto svg {
    flex: none;
  }

  .botao-cheio {
    background: var(--tinta);
    color: var(--papel);
  }

  .botao-cheio:hover {
    background: oklch(0.32 0.01 60);
  }

  .botao-linha {
    min-height: 2.75rem;
    border: 1.5px solid var(--tinta);
  }

  .botao-linha:hover {
    background: var(--tinta);
    color: var(--papel);
  }

  /* ---------- Topo e abertura ---------- */
  .topo {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem var(--margem);
  }

  .marca-topo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    white-space: nowrap;
    font-weight: 900;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .marca-topo img {
    width: 2.1rem;
    height: auto;
    padding: 0.3rem;
    border-radius: 8px;
    background: var(--tinta);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--cinza);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .ponto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: oklch(0.6 0 0);
  }

  [data-loja='aberta'] .ponto {
    background: oklch(0.62 0.17 145);
  }

  .abertura {
    padding: 1.25rem var(--margem) 1rem;
  }

  .abertura h1 {
    max-width: 18ch;
    font-size: clamp(2rem, 8.5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .sub {
    max-width: 44ch;
    margin-top: 0.6rem;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .fatos-linha {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 0.9rem;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .fatos-linha li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .filtros {
    display: flex;
    gap: 0.4rem;
    margin: 1.1rem calc(var(--margem) * -1) 0;
    padding: 0 var(--margem) 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filtro {
    flex: none;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    border: 1.5px solid var(--linha);
    font-size: 0.9375rem;
    font-weight: 700;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .filtro:hover {
    border-color: var(--tinta);
  }

  .filtro[aria-pressed='true'] {
    background: var(--mostarda);
    border-color: var(--tinta);
  }

  /* ---------- Busca fixa ---------- */
  .barra-busca {
    position: sticky;
    top: 0;
    z-index: var(--z-busca);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    padding: 0.6rem var(--margem) 0.4rem;
    background: var(--papel);
    border-bottom: 1px solid var(--linha);
  }

  .busca {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.9rem;
    border-radius: 999px;
    background: var(--cinza);
    border: 1.5px solid transparent;
    transition: border-color 0.15s;
  }

  .busca:focus-within {
    border-color: var(--tinta);
  }

  .busca svg {
    flex: none;
    color: var(--tinta-2);
  }

  .busca input {
    flex: 1;
    min-width: 0;
    min-height: 2.9rem;
    border: 0;
    background: none;
    font-size: 1rem;
    outline: none;
  }

  .busca input::placeholder {
    color: var(--tinta-2);
    opacity: 1;
  }

  .abas {
    display: flex;
    gap: 0.15rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .abas a {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--tinta-2);
  }

  .abas a:hover {
    color: var(--tinta);
  }

  .abas a[aria-current] {
    color: var(--tinta);
    background: var(--cinza);
  }

  .contagem {
    display: none;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 700;
  }

  [data-filtrando] .contagem {
    display: flex;
  }

  .limpar {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ---------- Lista ---------- */
  .corpo {
    padding: 0 var(--margem) 2rem;
  }

  .grupo {
    padding-top: 1.75rem;
  }

  .grupo-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--tinta);
  }

  .grupo-topo h2 {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }

  .grupo-topo p {
    font-size: 0.875rem;
    color: var(--tinta-2);
  }

  .lista {
    list-style: none;
    padding: 0;
  }

  .item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    grid-template-areas:
      'foto texto'
      'foto acoes';
    gap: 0.4rem 0.9rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--linha);
    scroll-margin-top: 9rem;
  }

  .item:target {
    background: linear-gradient(var(--mostarda), var(--mostarda)) 0 0 / 0.3rem 100% no-repeat;
    padding-left: 0.75rem;
  }

  .item picture {
    grid-area: foto;
  }

  .item-foto {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 10px;
    object-fit: cover;
    background: var(--cinza);
  }

  .item-texto {
    grid-area: texto;
    min-width: 0;
  }

  .item h3 {
    font-size: 1.0625rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .marca {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.35rem;
    background: var(--mostarda);
    font-size: 0.75rem;
    font-weight: 800;
    vertical-align: 0.15em;
    line-height: 1.5;
  }

  .marca-novo {
    background: var(--cinza);
  }

  .serve {
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .comp {
    margin-top: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .item-preco {
    margin-right: auto;
    font-weight: 900;
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .item-acoes {
    grid-area: acoes;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  .compartilhar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--tinta-2);
  }

  .compartilhar:hover {
    background: var(--cinza);
    color: var(--tinta);
  }

  .acao {
    flex: none;
  }

  .botao-add {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    padding: 0 1rem 0 0.75rem;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--papel);
    font-weight: 800;
    font-size: 0.9375rem;
    transition: background-color 0.15s;
  }

  .botao-add:hover {
    background: oklch(0.32 0.01 60);
  }

  .qtd {
    display: none;
    align-items: center;
    border-radius: 999px;
    background: var(--mostarda);
  }

  .qtd button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .qtd button:hover {
    background: oklch(0.2 0.01 60 / 0.1);
  }

  .qtd output,
  .qtd-n {
    min-width: 1.5ch;
    text-align: center;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  [data-na-sacola] .botao-add {
    display: none;
  }

  [data-na-sacola] .qtd {
    display: inline-flex;
  }

  .vazio {
    display: grid;
    justify-items: start;
    gap: 0.5rem;
    padding: 2.5rem 0;
    color: var(--tinta-2);
  }

  .vazio-titulo {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--tinta);
  }

  .vazio .botao {
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .item {
      grid-template-columns: 7rem minmax(0, 1fr) auto;
      grid-template-areas: 'foto texto acoes';
      align-items: center;
      column-gap: 1.25rem;
    }

    .item-foto {
      width: 7rem;
      height: 7rem;
    }

    .item-preco {
      min-width: 6.5rem;
      margin-right: 0.75rem;
      text-align: right;
    }
  }

  /* ---------- Cupom ao lado (computador) ---------- */
  .cupom-lateral {
    display: none;
  }

  .cupom,
  .cupom-dialogo .sacola-caixa {
    font-family: var(--mono);
  }

  .cupom-cabeca {
    padding-bottom: 0.75rem;
    border-bottom: 1.5px dashed var(--tinta);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (min-width: 64rem) {
    .corpo {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: 3rem;
      align-items: start;
    }

    .cupom-lateral {
      display: block;
      position: sticky;
      top: 9.5rem;
      padding-top: 1.75rem;
    }

    .barra {
      display: none !important;
    }

    .barra-busca {
      grid-template-columns: minmax(0, 26rem) auto 1fr;
